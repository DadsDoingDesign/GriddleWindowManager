{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Griddle WM",
  "version": "0.1.0",
  "identifier": "dev.griddle.wm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Griddle WM Brain",
        "url": "/brain",
        "visible": false,
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Griddle WM contributors",
    "copyright": "© 2026 Griddle WM contributors",
    "shortDescription": "Grid-based window manager for Windows 11",
    "longDescription": "Snaps real application windows onto user-configurable per-monitor (or monitor-spanning) grids, with a drag-time overlay preview and a live grid editor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
