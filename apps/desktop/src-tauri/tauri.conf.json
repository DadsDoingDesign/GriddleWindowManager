{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Griddle Window Manager",
  "version": "0.2.0",
  "identifier": "dev.griddle.wm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Griddle Window Manager Brain",
        "url": "/brain",
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling --disable-background-timer-throttling",
        "backgroundThrottling": "disabled",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://github.com https://objects.githubusercontent.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/DadsDoingDesign/GriddleWindowManager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzMTNCQkZBNkU1MkU5MApSV1NRTHVXbXZ6c3hDNElpcm55WEFUSWFubGcvTUNodVROcFJtWXpFbm81cjhkOGZBU0ZxQUQrcAo=",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Griddle Window Manager contributors",
    "copyright": "© 2026 Griddle Window Manager contributors",
    "shortDescription": "Grid-based window manager for Windows 11",
    "longDescription": "Griddle Window Manager snaps real application windows onto user-configurable per-monitor (or monitor-spanning) grids, with a drag-time overlay preview and a live grid editor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE.txt",
      "../../../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
